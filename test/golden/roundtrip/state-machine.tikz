\node[sg shape, text width=12mm, sg layer=layer1, circle, fill=sgBlue!85] (idle) at (0,0) {Idle};
\node[sg shape, text width=12mm, sg layer=layer1, circle, fill=sgGreen!85] (ready) at (45,0) {Ready};
\node[sg shape, text width=12mm, sg layer=layer1, circle, fill=sgPeach] (active) at (90,0) {Active};
\node[sg shape, text width=12mm, sg layer=layer1, circle, fill=sgGreen!85] (done) at (90,-43) {Done};
\node[sg shape, text width=12mm, sg layer=layer1, circle, fill=sgRed] (error) at (45,-43) {Error};
\draw[sg conn, sg id=connector, sg labels=7b2274657874223a2277616974227d, sg fixed] (idle.112) to[out=112,in=68,min distance=8mm] node[sg label, above, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {wait} (idle.68);
\draw[sg conn, sg id=connector-2, sg labels=7b2274657874223a227469636b227d, sg fixed] (active.22) to[out=22,in=-22,min distance=8mm] node[sg label, right, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {tick} (active.-22);
\draw[sg conn, sg id=connector-3, sg labels=7b2274657874223a227374617274227d, sg straight] (idle) -- node[sg label, above, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {start} (ready);
\draw[sg conn, sg id=connector-4, sg labels=7b2274657874223a22616363657074227d, sg straight] (ready) -- node[sg label, above, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {accept} (active);
\draw[sg conn, sg id=connector-5, sg labels=7b2274657874223a2266696e697368227d, sg straight] (active) -- node[sg label, right, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {finish} (done);
\draw[sg conn, sg id=connector-6, sg labels=7b2274657874223a226661696c227d, sg fixed] (active) to[bend left=14] node[sg label, above, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {fail} (error);
\draw[sg conn, sg id=connector-7, sg labels=7b2274657874223a227265747279227d, sg straight] (error) -- node[sg label, left, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {retry} (ready);
\draw[sg conn, sg id=connector-8, sg labels=7b227374796c65223a7b227365676d656e74223a317d2c2274657874223a227265736574222c226c656761637953696465223a2262656c6f77227d, sg fixed] ([xshift=0mm]done.south) -- ([xshift=0mm]done.south |- 0,-65) -- node[sg label, below, outer sep=0pt, text height=7.5pt, text depth=5pt, text=sgc808080, font=\sffamily\small] {reset} (-25,-65) -- ([yshift=0mm]idle.west -| -25,0) -- ([yshift=0mm]idle.west);
