% sakuga group g2 {secure world} region green
% sakuga group g3 {operation} dotted grey in=g2
\begin{tikzpicture}[x=1mm, y=1mm, font=\sffamily\small]
% sakuga theme begin (generated from the style lines above)
\definecolor{sgc454545}{HTML}{454545}
\definecolor{sgc737373}{HTML}{737373}
\definecolor{sgc7A8566}{HTML}{7A8566}
\definecolor{sgc858585}{HTML}{858585}
\definecolor{sgBlue}{HTML}{BBCCEE}
\definecolor{sgGreen}{HTML}{CCDDAA}
\definecolor{sgPeach}{HTML}{FFDDCC}
\definecolor{sgGrey}{HTML}{DDDDDD}
\definecolor{sgYellow}{HTML}{EEEEBB}
\definecolor{sgCyan}{HTML}{CCEEFF}
\definecolor{sgRed}{HTML}{FFCCCC}
\definecolor{palRose}{HTML}{CC6677}
\definecolor{black}{HTML}{000000}
\def\sgcontent#1#2#3{\def\sgpos{#1}\def\sgleft{left}\def\sgright{right}\def\sgsw{sw}\def\sgse{se}\ifx\sgpos\sgleft\makebox[#2mm][r]{\parbox{\dimexpr#2mm-4mm\relax}{\centering#3}}\else\ifx\sgpos\sgright\makebox[#2mm][l]{\parbox{\dimexpr#2mm-4mm\relax}{\centering#3}}\else\ifx\sgpos\sgsw\parbox{#2mm}{\centering#3\par\vspace*{4mm}}\else\ifx\sgpos\sgse\parbox{#2mm}{\centering#3\par\vspace*{4mm}}\else\parbox{#2mm}{\vspace*{4mm}\centering#3}\fi\fi\fi\fi}
\def\sgcodesize{}\tikzset{sg want/.style={},sg code font/.code={\def\sgcodesize{\csname#1\endcsname}}}
\def\sgcode#1{{\ifdim\csname f@size\endcsname pt<9pt\tiny\else\ifdim\csname f@size\endcsname pt<10pt\scriptsize\else\ifdim\csname f@size\endcsname pt<10.5pt\footnotesize\else\ifdim\csname f@size\endcsname pt<11.5pt\small\else\normalsize\fi\fi\fi\fi\sgcodesize\ttfamily\textcolor{black!48}{#1}}}
\def\sgstep#1{\tikz[baseline=-0.6ex]\node[circle,fill=.,text=white,font=\sffamily\bfseries\scriptsize,inner sep=1pt,minimum size=3.6mm]{#1};}
\def\sglabel#1#2{\raisebox{\dimexpr\depth/2-\height/2\relax}{\sgstep{#1}}\hspace{0.8mm}\raisebox{\dimexpr\depth/2-\height/2\relax}{\shortstack{#2}}}
\tikzset{
  sg box/.style={draw=black!38, line width=0.45pt, rounded corners=1.4pt, align=center,
    inner xsep=3pt, inner ysep=3.5pt, minimum height=6mm, text width=26mm, fill=white},
  sg compact/.style={inner xsep=1pt, inner ysep=1pt, minimum height=0pt},
  sg label/.style={sg box, draw=none, fill=none, rounded corners=0pt}, sg label height/.style={minimum height={#1mm-0.45pt}},
  sg style/work/.style={sg box, fill=sgPeach},
  sg style/cryptoservice/.style={sg box, fill=sgBlue!85},
  sg style/tee/.style={sg box, fill=sgGreen!85},
  sg style/riot/.style={sg box, fill=sgGrey!70},
  arr/.style={-{Latex[length=1.5mm, width=1.2mm]}, draw=black!50, line width=0.45pt, rounded corners=2pt},
  head both/.style={{Latex[length=1.5mm, width=1.2mm]}-{Latex[length=1.5mm, width=1.2mm]}},
  head none/.style={-},
  sg elabel/.style={align=center, text=black!65, font=\sffamily\scriptsize, fill=white, inner sep=1pt},
  sg labels/.style={}, sg label side/.style={}, sg label position/.style={}, sg step/.style={}, sg lane/.style={}, sg line width/.style={}, sg tip length/.style={}, sg tip width/.style={}, sg route/.style={}, sg mid/.style={}, sg bend/.style={}, sg implicit from/.style={}, sg implicit to/.style={},
  sg straight/.style={}, sg manhattan/.style={}, sg curved/.style={}, sg fixed/.style={},
  sg icon height/.style={minimum height=#1mm}, sg icon/.style={}, sg icon position/.style={}, sg in/.style={}, sg layer/.style={}, sg hidden/.style={}, sg locked/.style={}, sg opacity/.style={},
  sg frame dashed/.style={draw=black!55, line width=0.7pt, dash pattern=on 9pt off 3pt, rounded corners=2.5pt, inner sep=2.8mm},
  sg frame dotted/.style={draw=black!55, line width=1.5pt, line cap=round, dash pattern=on 0pt off 4.5pt, rounded corners=2.5pt, inner sep=1.8mm},
  sg frame region/.style={rounded corners=1.5pt, inner sep=3mm},
  sg frame solid/.style={draw=black!55, line width=0.7pt, rounded corners=2.5pt, inner sep=3mm},
  sg frame none/.style={inner sep=0pt},
  sg glabel/.style={font=\sffamily\scriptsize, text=black!55, inner sep=1.5pt},
  arr-dashed/.style={arr, draw=black!35, dash pattern=on 1.4pt off 1.4pt},
  sg swatch/.style={draw=black!38, line width=0.45pt, rounded corners=1pt,
    minimum width=3.6mm, minimum height=3.6mm, inner sep=0pt},
}
% sakuga theme end
\node[sg style/riot, text width=58mm] (app) at (0,0) {Application};
\node[sg style/work, text width=58mm, sg in=g1] (att) at (0,-1.92) {PSA Attestation API\\[-1pt]\sgcode{psa\_initial\_attest\_get\_token}};
\node[sg style/work, text width=58mm, sg in=g1] (seam) at (0,-1.92) {Backend interface\\[-1pt]\sgcode{attest\_backend\_get\_token}};
\node[sg style/work, sg in=g1] (swbe) at (-15,-35) {Software backend};
\node[sg style/work, sg in=g1] (teebe) at (15,-35) {TEE backend};
\node[sg style/work, sg in=g1] (nsenc) at (-15,-46) {Providers and token encoder};
% sakuga hidden \node[sg style/riot] (psac) at (-15,-60) {PSA Crypto};
\node[sg style/cryptoservice, text width=58mm] (cysapi) at (0,-74) {CryptoService API\\[-1pt]\sgcode{CYS\_attest\_get\_token}};
\node[sg style/tee, text width=58mm, sg in=g2] (entry) at (0,-1.92) {Secure entry and dispatch table\\[-1pt]\sgcode{tee\_secure\_entry}};
\node[sg style/work, sg want=26, text width=37.96mm, sg in=g3] (hdl) at (-15,-104) {Attestation handler\\[-1pt]\sgcode{tee\_attest\_get\_token}};
\node[sg style/work, sg in=g3] (senc) at (-15,-117) {Providers and token encoder};
\node[sg style/tee, sg in=g2] (ops) at (15,-110) {Crypto and RoT operations};
\node[sg style/riot, text width=58mm] (drv) at (0,0) {CC310 driver};
\node[sg style/riot, text width=58mm] (hw) at (0,-141) {CC310};
