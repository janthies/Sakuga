\draw[arr, sg route=auto, sg implicit from, sg implicit to] ([xshift=0.6939mm]entry.south) -- ([xshift=-0.7182mm]ops.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] (hdl.south) -- (hdl.south |- senc.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] ([xshift=0.6635mm]senc.north) -- ([xshift=-0.3949mm]drv.south);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] ([xshift=-0.7057mm]ops.north) -- ([xshift=0.42mm]drv.south);
