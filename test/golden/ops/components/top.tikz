\draw[arr, head both, sg route=auto, sg implicit from, sg implicit to] (teebe.south) -- (teebe.south |- cysapi.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] (cysapi.north) -- (cysapi.north |- entry.south);
