\node[sg glabel, anchor=north west, outer sep=0pt, text height=6pt, text depth=2pt, font=\sffamily\scriptsize] at (g2.north west) {secure world};
\path[sg frame dashed, fill=none, draw=sgc737373, dash pattern=on 9pt off 3pt, line cap=butt, line width=0.7pt] (g1.south west) rectangle (g1.north east);
\path[sg frame dotted, fill=none, draw=sgc737373, dash pattern=on 0pt off 4.5pt, line cap=round, line width=1.5pt] (g3.south west) rectangle (g3.north east);
\end{scope}
% sakuga groups end
\draw[arr, sg route=auto, sg implicit from, sg implicit to] (app.south) -- (app.south |- att.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] (att.north) -- (att.north |- seam.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] ([xshift=-2.267mm]seam.south) -- ([xshift=2.3467mm]swbe.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] ([xshift=2.267mm]seam.south) -- node[sg elabel, outer sep=0pt, text height=7.5pt, text depth=5pt, font=\sffamily\small] {calls} ([xshift=-1.3966mm]teebe.north);
\draw[arr, sg route=auto, sg implicit from, sg implicit to] (swbe.south) -- (swbe.south |- nsenc.north);
