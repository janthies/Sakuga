\node[sg style/tee, text width=73.83mm, sg in=g2] (entry) at (7.11,-91.19) {Secure entry and dispatch table\\[-1pt]\sgcode{tee\_secure\_entry}};
\node[sg style/work, sg want=26, text width=37.96mm, sg in=g3] (hdl) at (-9.02,-106.99) {Attestation handler\\[-1pt]\sgcode{tee\_attest\_get\_token}};
\node[sg style/work, text width=37.96mm, sg in=g3] (senc) at (-9.02,-121.16) {Providers and token encoder};
