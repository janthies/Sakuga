{
	"name": "sakuga",
	"displayName": "Sakuga",
	"description": "Draw TikZ figures in your house style: the file is TikZ, the canvas edits it",
	"publisher": "jan",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "sakuga.figure",
				"displayName": "Sakuga",
				"selector": [
					{
						"filenamePattern": "*.sakuga.tikz"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "sakuga.newFigure",
				"title": "New figure",
				"category": "Sakuga"
			},
			{
				"command": "sakuga.sketch.left",
				"title": "Align left",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.centerX",
				"title": "Align horizontal centre",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.right",
				"title": "Align right",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.top",
				"title": "Align top",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.centerY",
				"title": "Align vertical centre",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.bottom",
				"title": "Align bottom",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.distributeX",
				"title": "Distribute horizontal gaps",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.distributeY",
				"title": "Distribute vertical gaps",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.sameW",
				"title": "Same width",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.sameH",
				"title": "Same height",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			},
			{
				"command": "sakuga.sketch.tidy",
				"title": "Tidy up",
				"category": "Sakuga",
				"enablement": "activeCustomEditorId == sakuga.figure"
			}
		],
		"keybindings": [
			{
				"command": "sakuga.sketch.left",
				"key": "alt+a",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.centerX",
				"key": "alt+c",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.right",
				"key": "alt+d",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.top",
				"key": "alt+w",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.centerY",
				"key": "alt+v",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.bottom",
				"key": "alt+s",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.distributeX",
				"key": "alt+x",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.distributeY",
				"key": "alt+y",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.sameW",
				"key": "alt+u",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.sameH",
				"key": "alt+b",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			},
			{
				"command": "sakuga.sketch.tidy",
				"key": "alt+t",
				"when": "activeCustomEditorId == sakuga.figure && webviewFocus"
			}
		]
	},
	"scripts": {
		"compile": "node scripts/build.cjs",
		"typecheck": "tsc -b",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs",
		"fitness": "node scripts/fitness.cjs",
		"test:golden": "node --import tsx --test test/*.test.ts",
		"test:webview": "node --import tsx --test test/webview/*.test.ts",
		"test:tex": "node --import tsx --test test/tex/*.test.ts",
		"check": "npm run compile && npm run typecheck && npm run depcruise && npm run format:check && npm run fitness && npm run test:golden && npm run test:webview",
		"check:tex": "npm run test:tex && for f in scripts/check-architecture.cjs scripts/check-boxdeco.cjs scripts/check-icons.cjs scripts/check-labels.cjs scripts/check-layers.cjs scripts/check-opacity.cjs scripts/check-routing.cjs scripts/check-styles.cjs scripts/check-styling.cjs; do echo \"== $f\"; nice -n 19 node $f || exit 1; done",
		"format": "prettier --write \"src/**/*.ts\" \"media/*.css\" \"test/**/*.ts\" \"scripts/*.cjs\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"media/*.css\" \"test/**/*.ts\" \"scripts/*.cjs\"",
		"check:perf": "SAKUGA_PERF=1 node --import tsx --test test/webview/perf.test.ts"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "1.100.0",
		"@vscode/vsce": "2.32.0",
		"dependency-cruiser": "^16.10.4",
		"esbuild": "^0.28.2",
		"jsdom": "24.1.3",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "5.9.3"
	}
}
