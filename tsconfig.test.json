{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"noImplicitAny": false,
		"rootDir": ".",
		"outDir": ".tsbuild/test",
		"tsBuildInfoFile": ".tsbuild/test.tsbuildinfo",
		"strictNullChecks": false
	},
	"include": [
		"test/**/*.ts"
	],
	"references": [
		{
			"path": "./tsconfig.host.json"
		}
	]
}
