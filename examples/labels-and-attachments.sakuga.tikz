\tikzset{sg icon stroke/.style={draw=black!60,line width=0.6pt,line cap=round,line join=round}}
\tikzset{pics/sg object/.style n args={3}{code={\path (-#2/2,-#3/2) rectangle (#2/2,#3/2);\node[anchor=center,inner sep=0pt,outer sep=0pt,minimum width=#2mm,minimum height=#3mm] (-center) at (0,0) {};\if\relax\detokenize{#1}\relax\else\pic[xscale=#2/3,yscale=#3/3] at (-#2/2,#3/2) {sg icon/#1};\fi\node[anchor=west,inner sep=0pt,align=left] (-label) at (#2/2+1,0) {\tikzpictext};}}}
\def\sgicon#1{\tikz[baseline=-0.3pt]{\path[use as bounding box] (0,0) rectangle (8.544pt,8.544pt);\pic at (0,8.544pt) {sg icon/#1};}}
\tikzset{sg icon/board/.pic={\begin{scope}[x=1pt,y=1pt,scale=0.355659449,yscale=-1,sg icon stroke]\draw svg "M4 4h16v16H4z";\draw svg "M8 8h6v6H8z M14 11h3v6h-6v3 M4 11h4";\end{scope}}}
